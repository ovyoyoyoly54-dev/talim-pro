DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_SITE_URL=
DJANGO_SECURE_SSL_REDIRECT=True
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
POSTGRES_PASSWORD=
# Proksi orqasida bo'lsangiz ishonchli proksilar sonini yozing (masalan 1), aks holda 0.
TRUSTED_PROXY_COUNT=0
# Ko'pi bilan nechta o'quv guruhi bo'lishi mumkin (0 — cheklovsiz).
MAX_STUDY_GROUPS=5
# Bir nechta gunicorn ishchisida urinishlar limiti to'g'ri ishlashi uchun True qiling.
DJANGO_DB_CACHE=True
# Optional one-time production administrator bootstrap; remove after account is created.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=
# Optional SMS integration. Keep credentials out of source control.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=Tal'im Pro

# To'lov tizimlari (Click / Payme). Bo'sh qoldirilsa, tegishli usul o'chiq bo'ladi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=False
INVOICE_DUE_DAY=10

# Web Push bildirishnomalari (`python manage.py generate_vapid_keys` bilan yarating)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
# Qo'shimcha ishonchli push xizmatlari (vergul bilan). Standart: Chrome/Firefox/Edge/Safari xizmatlari.
PUSH_EXTRA_HOSTS=
# Administratorlar uchun 2FA ni majburiy qilish (standart: ixtiyoriy).
ADMIN_2FA_REQUIRED=False
